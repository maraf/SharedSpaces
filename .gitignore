# Squad: ignore runtime state (logs, inbox, sessions)
.squad/orchestration-log/
.squad/log/
.squad/decisions/inbox/
.squad/sessions/
# Squad: SubSquad activation file (local to this machine)
.squad-workstream
.squad/config.json

# .NET build outputs
**/bin/
**/obj/

# Test and runtime artifacts
*.trx
TestResults/
artifacts/

# Local SQLite database files
*.db
*.db-shm
*.db-wal
build.log

# MSBuild local build caches
*.lscache

# Playwright MCP tool output (screenshots/logs from ad-hoc browser automation)
.playwright-mcp/
